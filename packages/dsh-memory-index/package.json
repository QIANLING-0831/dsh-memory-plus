{
  "name": "dsh-memory-index",
  "description": "Hybrid memory search for the DeepSeek Harness — sqlite-vec vector arm + FTS5 lexical arm (RRF fusion) over session events, with local bge embeddings via transformers.js. Provides ctx.memorySearch.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIANLING-0831/dsh-memory-plus.git",
    "directory": "packages/dsh-memory-index"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "hybrid-search",
    "vector-search",
    "embedding"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-rc.3 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "dsh-session-query-sqlite-cjk": "workspace:*"
  }
}
