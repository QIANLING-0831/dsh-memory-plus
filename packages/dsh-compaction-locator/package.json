{
  "name": "dsh-compaction-locator",
  "description": "Near-lossless compaction for the DeepSeek Harness — extends BasicCompactionEngine so each <compacted-summary> ends with an Exact Sources locator block (spill files, touched file paths, seq range), making compacted details recoverable via memory_search / read.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIANLING-0831/dsh-memory-plus.git",
    "directory": "packages/dsh-compaction-locator"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "memory",
    "locator"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-rc.2",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-rc.2",
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
