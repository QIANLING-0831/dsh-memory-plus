{
  "name": "dsh-tool-result-dedup",
  "description": "Tool-result dedup policy for the DeepSeek Harness — replaces byte-identical repeated plain-text tool results with a pointer to the first occurrence (hash-indexed), saving input tokens on long sessions.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIANLING-0831/dsh-memory-plus.git",
    "directory": "packages/dsh-tool-result-dedup"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dedup",
    "token-savings",
    "tool-result"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-output-retention": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
