{
  "name": "dsh-memory-bundle",
  "description": "Meta-bundle: installs all dsh-memory plugins (CJK search, dedup, hybrid memory index, memory tool, compaction locator, core memory with a user-pinned no-model-write layer, skill manager + provenance-guarded self-evolution) into a DeepSeek Harness profile as one patch layer.",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIANLING-0831/dsh-memory-plus.git",
    "directory": "packages/dsh-memory-bundle"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bundle",
    "memory"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-compaction-locator": "workspace:^",
    "dsh-memory-core": "workspace:^",
    "dsh-memory-index": "workspace:^",
    "dsh-memory-skills": "workspace:^",
    "dsh-memory-tool": "workspace:^",
    "dsh-session-query-sqlite-cjk": "workspace:^",
    "dsh-tool-result-dedup": "workspace:^"
  },
  "author": "QIANLING-0831",
  "homepage": "https://github.com/QIANLING-0831/dsh-memory-plus#readme"
}
