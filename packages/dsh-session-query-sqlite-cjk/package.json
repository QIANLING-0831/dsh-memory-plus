{
  "name": "dsh-session-query-sqlite-cjk",
  "description": "CJK-aware ctx.sessionQuery backend for the DeepSeek Harness — SQLite FTS5 provider with a trigram tokenizer table so Chinese full-text search actually matches (upstream unicode61 does not segment CJK), plus a LIKE fallback for 1-2 character CJK queries.",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIANLING-0831/dsh-memory-plus.git",
    "directory": "packages/dsh-session-query-sqlite-cjk"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-query",
    "fts5",
    "cjk",
    "chinese"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-rc.3 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2"
  },
  "author": "QIANLING-0831",
  "homepage": "https://github.com/QIANLING-0831/dsh-memory-plus#readme"
}
